# TicketForge (Python) — copy to `.env` and fill in.

# Required for extraction + transcription (https://console.groq.com/keys)
GROQ_API_KEY=

# Required to push tickets (https://linear.app/settings/api)
LINEAR_API_KEY=

# Optional — override the default models
# EXTRACT_MODEL=llama-3.3-70b-versatile
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Change this in production — signs the session cookie
SESSION_SECRET=ticketforge-dev-secret-change-me
